{
  "build": {
    "rootFile": "main.tex",
    "engine": "pdflatex",
    "onSave": false
  },
  "diagnostics": {
    "undefinedReferences": true,
    "undefinedCitations": true,
    "chktex": {
      "enabled": true,
      "arguments": [
        "-w46"
      ]
    }
  },
  "inlayHints": {
    "enabled": true,
    "numbers": true,
    "pages": false,
    "citations": true
  }
}
