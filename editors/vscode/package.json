{
  "name": "texquill",
  "displayName": "TeXquill",
  "description": "LaTeX language support powered by the texquill Rust language server.",
  "version": "1.0.0",
  "publisher": "Jacky-Lzx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jacky-Lzx/texquill.git",
    "directory": "editors/vscode"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "keywords": ["latex", "tex", "bibtex", "lsp"],
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "TeXquill starts a local language server and can run TeX tools."
    },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": ["onLanguage:latex", "onLanguage:tex", "onLanguage:plaintex", "onLanguage:bibtex", "onLanguage:bib", "onLanguage:bst", "onLanguage:bibtex-style", "onWebviewPanel:texquill.pdfPreview"],
  "contributes": {
    "languages": [
      { "id": "bst", "aliases": ["BibTeX Style", "bst"], "extensions": [".bst"] }
    ],
    "configurationDefaults": {
      "[latex]": { "editor.linkedEditing": true },
      "[tex]": { "editor.linkedEditing": true },
      "[plaintex]": { "editor.linkedEditing": true }
    },
    "configuration": {
      "title": "TeXquill",
      "properties": {
        "texquill.serverPath": {
          "type": "string",
          "default": "texquill",
          "scope": "machine",
          "markdownDescription": "Path to the separately installed `texquill` executable, or its name on PATH. Use an absolute path when VS Code cannot find your shell's tools."
        },
        "texquill.serverEnvironment": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" },
          "scope": "machine",
          "markdownDescription": "Environment variables added to the language server process. Set `PATH` here if TeX tools are unavailable to VS Code. Restarted automatically when changed."
        },
        "texquill.settings": {
          "type": "object",
          "default": {},
          "scope": "window",
          "markdownDescription": "Server settings sent as initializationOptions and updated live. Supports `build`, `formatting`, `diagnostics`, `distribution`, `indexing`, and `inlayHints`. Omitted values use server defaults. Use `.texquill.json` for settings specific to a project or workspace folder.",
          "additionalProperties": false,
          "properties": {
            "build": { "type": "object", "description": "Build tools, engine, paths, arguments, timeout, and onSave." },
            "formatting": { "type": "object", "description": "LaTeX and BibTeX formatting settings." },
            "diagnostics": { "type": "object", "description": "Static checks and ChkTeX settings." },
            "distribution": { "type": "object", "description": "TeX distribution discovery settings." },
            "indexing": { "type": "object", "description": "Workspace indexing limits and exclusions." },
            "inlayHints": { "type": "object", "description": "Reference and citation inlay hints." }
          }
        },
        "texquill.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "scope": "window",
          "description": "Trace language server communication in the TeXquill trace output."
        }
      }
    },
    "keybindings": [
      { "command": "texquill.forwardSearch", "key": "ctrl+alt+j", "mac": "cmd+alt+j", "when": "editorTextFocus && editorLangId =~ /^(latex|tex|plaintex)$/" }
    ],
    "menus": {
      "editor/context": [
        { "command": "texquill.forwardSearch", "when": "resourceScheme == file && editorLangId =~ /^(latex|tex|plaintex)$/", "group": "navigation@20" }
      ]
    },
    "commands": [
      { "command": "texquill.build", "title": "Build", "category": "TeXquill" },
      { "command": "texquill.rebuild", "title": "Rebuild", "category": "TeXquill" },
      { "command": "texquill.cancelBuild", "title": "Cancel Build", "category": "TeXquill" },
      { "command": "texquill.buildStatus", "title": "Show Build Status", "category": "TeXquill" },
      { "command": "texquill.openPdf", "title": "Open PDF", "category": "TeXquill" },
      { "command": "texquill.forwardSearch", "title": "Forward Search (TeX to PDF)", "category": "TeXquill", "enablement": "resourceScheme == file && editorLangId =~ /^(latex|tex|plaintex)$/" },
      { "command": "texquill.restart", "title": "Restart Server", "category": "TeXquill" },
      { "command": "texquill.showOutput", "title": "Show Output", "category": "TeXquill" }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && node scripts/build-preview.cjs",
    "check": "tsc -p . --noEmit && node --check media/preview/main.mjs && node --check scripts/build-preview.cjs && node --check media/preview/coordinates.mjs",
    "watch": "tsc -p . --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --out texquill.vsix",
    "test": "npm run compile && node --test scripts/test-coordinates.mjs && node scripts/test.cjs",
    "test:neovim": "npm run compile && node scripts/test.cjs --neovim"
  },
  "dependencies": { "vscode-languageclient": "^9.0.1" },
  "overrides": {
    "@azure/msal-node": { "uuid": "^11.1.1" }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "pdfjs-dist": "6.4.299",
    "typescript": "^5.9.3"
  }
}
